# Copy to .env for local work. .env is gitignored — never commit real values.
# Every variable is read from the environment; nothing is baked into the binary.

# Database. Omit both for the default local file (jtrax.db) with auto-seeding.
#   local:  a file path
#   Turso:  libsql://<database>-<org>.turso.io
DATABASE_URL=
# From `turso db tokens create jtrax`. Kept separate from DATABASE_URL so the
# secret never appears in a value that gets logged or pasted into a dashboard.
TURSO_AUTH_TOKEN=

# Seeding. A local database seeds itself; a remote one must opt in, and then
# JTRAX_SEED_PASSWORD is mandatory because the dev password is in the repo.
# Unset JTRAX_SEED after the first successful deploy.
JTRAX_SEED=
JTRAX_SEED_PASSWORD=

# Real staff sign-ins, as a JSON array. Applied on every boot: an account that
# does not exist is created, one that does has its password, role and name
# updated — which is also how a forgotten password gets reset. role is Admin or
# Receptionist; password must be at least 8 characters. Unset it once the
# accounts exist, so no password sits in the service configuration.
#   [{"email":"head@jca.ac.th","password":"…","role":"Admin","name":"JCA Head Office","phone":"02-123-4567"},
#    {"email":"front@jca.ac.th","password":"…","role":"Receptionist","name":"Front Desk"}]
JTRAX_STAFF=

# The ten families the admin console used to hard-code, as real parent and
# student accounts sharing JTRAX_ROSTER_PASSWORD. Re-running updates rather
# than duplicates. Unset both once imported.
JTRAX_ROSTER=
JTRAX_ROSTER_PASSWORD=

# Comma-separated origins allowed to call the API from a browser. The portals
# proxy through their own /api route server-side, so this is only a safety net.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Forgot-password email. Plain SMTP, so the provider is a configuration choice:
# Brevo, Resend, Gmail and a self-hosted relay all work with these five values.
# Leave SMTP_HOST empty in development — the API then logs the reset link
# instead of sending it, and says in the log that the line is sensitive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The envelope sender. Must be an address the provider has let you verify,
# or mail is silently dropped or spam-foldered.
MAIL_FROM=
# Public address of each frontend, used to build the link in the email:
#   <APP_URL or ADMIN_URL>/reset-password?token=…
# Which one is used is decided from the account's role on the server — staff go
# to the console, everyone else to the web app. If ADMIN_URL is unset, staff
# links fall back to APP_URL.
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# LINE Official Account messaging. Unlike everything else here, the channel
# credentials are NOT set as environment variables — an admin types them into
# the console at runtime, and they are stored encrypted. This is the key that
# encrypts them, and it is the one thing that must live in the environment:
# without it the console refuses to store credentials rather than keeping them
# in clear. Generate with `openssl rand -base64 32`.
#
# Losing or changing this key does not lose messages, but it does make the
# stored credentials unreadable — an admin re-enters them and carries on.
LINE_TOKEN_KEY=

# Only for pointing the client at something other than api.line.me — a test
# stub, or an egress proxy. Leave empty in normal use.
LINE_API_BASE=

# Lichess ratings. No credential of any kind — every endpoint used is public,
# which is why this feature costs nothing to run. This variable exists only to
# point the client at a stub in tests, or at an egress proxy. Leave it empty.
LICHESS_API_BASE=

# Render sets this automatically; 8080 locally.
PORT=8790

# Overrides https://chess-results.com for tests and egress proxies. External
# tournaments are read from here; the site cannot be written to by anyone.
CHESS_RESULTS_API_BASE=
