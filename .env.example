# Copy to .env for local work. .env is gitignored — never commit real values.
# Every variable is read from the environment; nothing is baked into the binary.

# Database. Omit both for the default local file (jtrax.db) with auto-seeding.
#   local:  a file path
#   Turso:  libsql://<database>-<org>.turso.io
DATABASE_URL=
# From `turso db tokens create jtrax`. Kept separate from DATABASE_URL so the
# secret never appears in a value that gets logged or pasted into a dashboard.
TURSO_AUTH_TOKEN=

# Seeding. A local database seeds itself; a remote one must opt in, and then
# JTRAX_SEED_PASSWORD is mandatory because the dev password is in the repo.
# Unset JTRAX_SEED after the first successful deploy.
JTRAX_SEED=
JTRAX_SEED_PASSWORD=

# Comma-separated origins allowed to call the API from a browser. The portals
# proxy through their own /api route server-side, so this is only a safety net.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Render sets this automatically; 8080 locally.
PORT=8790
